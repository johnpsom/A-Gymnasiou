% ---------- δομή: Μέρος, Κεφάλαιο, Παράγραφος ----------
\renewcommand{\thechapter}{\arabic{chapter}}
\renewcommand{\thesection}{\arabic{section}}
\newcommand{\partpfx}{}
\newcommand{\chaptertitlefont}{\bfseries\fontsize{19}{24}\selectfont}
\titleformat{\chapter}[block]{\normalfont}{}{0pt}{}
\titlespacing*{\chapter}{0pt}{0pt}{0pt}

% \meros{Α}{ΑΡΙΘΜΗΤΙΚΗ – ΑΛΓΕΒΡΑ}: σελίδα μέρους. Τα κεφάλαια ξεκινούν πάλι από το 1.
\newcommand{\meros}[3]{%
  \cleardoublepage\thispagestyle{empty}\setcounter{chapter}{0}%
  \renewcommand{\partpfx}{#3}%
  \addcontentsline{toc}{part}{Μέρος #1΄: #2}%
  \vspace*{50mm}%
  {\color{gblue}\bfseries\Large Μέρος #1΄}\par\vspace{3mm}
  {\raggedright\bfseries\fontsize{26}{32}\selectfont #2\par}
  \clearpage}

% \kefalaio{τίτλος}{μότο}{λίστα παραγράφων}: σελίδα κεφαλαίου
\newcommand{\kefalaio}[3]{%
  \clearpage\thispagestyle{empty}\refstepcounter{chapter}\setcounter{section}{0}%
  \addcontentsline{toc}{chapter}{Κεφάλαιο \partpfx\thechapter: #1}\tunepage{\partpfx k\thechapter}%
  \markboth{#1}{#1}%
  \vspace*{16mm}%
  {\color{gblue}\bfseries\Large Κεφάλαιο \partpfx\thechapter}\par\vspace{3mm}
  {\raggedright\bfseries\fontsize{24}{30}\selectfont #1\par}\vspace{6mm}
  {\color{ggray}\itshape\large «#2»\par}\vspace{10mm}
  {\color{gblue}\bfseries Στο κεφάλαιο αυτό\par}\vspace{1ex}
  \noindent\begin{minipage}{\linewidth}\small #3\end{minipage}\par
  \clearpage}

% \paragrafos{τίτλος}{παραπομπή}: παράγραφος (υποενότητα) του κεφαλαίου
\newcommand{\paragrafos}[2]{%
  \clearpage\refstepcounter{section}%
  \addcontentsline{toc}{section}{\protect\numberline{\partpfx\thechapter.\thesection}#1}%
  \markboth{\partpfx\thechapter.\thesection\ #1}{\partpfx\thechapter.\thesection\ #1}%
  \setcounter{exer}{0}\setcounter{paradeigma}{0}\renewcommand{\exprefix}{\partpfx\thechapter.\thesection}%
  \vspace*{14mm}%
  {\color{gblue}\bfseries\large Παράγραφος \partpfx\thechapter.\thesection}\par\vspace{3mm}
  {\raggedright\chaptertitlefont #1\par}\vspace{5mm}
  {\color{ggray}\small Σχολικό βιβλίο: #2\par}\vspace{6mm}
}

% \ypotmima{Α}{τίτλος}: υποδιαίρεση μιας μεγάλης παραγράφου (η αρίθμηση ασκήσεων συνεχίζεται)
\newcommand{\ypotmima}[2]{\par\Needspace{10\baselineskip}\vspace{2.5ex}%
  {\color{gblue}\bfseries\Large #1.\ #2}\par\vspace{0.3ex}{\color{gblue}\hrule height 0.8pt}\vspace{1.5ex}\par}

% ---------- τίτλοι ενοτήτων μέσα στο κεφάλαιο ----------
\newcommand{\tmima}[1]{\par\Needspace{10\baselineskip}\vspace{1.2ex}{\color{gblue}\bfseries\large #1}\par\nopagebreak\vspace{0.4ex}}
\newcommand{\tmimasmall}[1]{\par\Needspace{4\baselineskip}\vspace{0.8ex}{\bfseries #1}\par\nopagebreak}

